<Styles xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.fondo">
    <Setter Property="Background" Value="{StaticResource Fondo}" />
  </Style>

  <Style Selector="Border.marco">
    <Setter Property="Background" Value="{StaticResource Marco}" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.lienzo">
    <Setter Property="Background" Value="{StaticResource Lienzo}" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.marca">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="9" />
  </Style>

  <Style Selector="Border.estadoConexion">
    <Setter Property="Background" Value="{StaticResource RosaFondo}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Button">
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.pildoraPrincipal">
    <Setter Property="Background" Value="{StaticResource Tinta}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2A2E" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pildoraPrincipal Path">
    <Setter Property="Fill" Value="White" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:disabled">
    <Setter Property="Background" Value="#E8E8EC" />
    <Setter Property="BorderBrush" Value="#D8D8DE" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:disabled TextBlock">
    <Setter Property="Foreground" Value="#74747C" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:disabled Path">
    <Setter Property="Fill" Value="#74747C" />
  </Style>

  <Style Selector="Button.pildora">
    <Setter Property="Background" Value="{StaticResource Tarjeta}" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="15,9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.pildora TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
  </Style>
  <Style Selector="Button.pildora:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TarjetaHover}" />
  </Style>
  <Style Selector="Button.pildora:disabled">
    <Setter Property="Background" Value="#E9E9ED" />
    <Setter Property="BorderBrush" Value="#D9D9DF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.pildora:disabled TextBlock">
    <Setter Property="Foreground" Value="#6F6F77" />
  </Style>
  <Style Selector="Button.pildora:disabled Path">
    <Setter Property="Stroke" Value="#6F6F77" />
  </Style>

  <Style Selector="Button.contorno">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.contorno:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Tarjeta}" />
  </Style>

  <Style Selector="Button.cuadrado">
    <Setter Property="Background" Value="{StaticResource Tarjeta}" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.insignia">
    <Setter Property="Background" Value="{StaticResource Insignia}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.insignia TextBlock">
    <Setter Property="Foreground" Value="#2B2F6B" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.barraFlotante">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="6,10" />
    <Setter Property="Width" Value="52" />
  </Style>

  <Style Selector="Button.icono">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icono Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{StaticResource TintaSuave}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Button.icono:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Tarjeta}" />
  </Style>
  <Style Selector="Button.icono:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource Tinta}" />
  </Style>
  <Style Selector="Button.icono:disabled">
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <Style Selector="Border.tarjeta">
    <Setter Property="Background" Value="{StaticResource Tarjeta}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.baldosa">
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,6" />
  </Style>

  <Style Selector="Border.avisoPeligro">
    <Setter Property="Background" Value="{StaticResource RosaFondo}" />
    <Setter Property="BorderBrush" Value="#F5D1E2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="TextBlock.titular">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    <Setter Property="LetterSpacing" Value="-1" />
  </Style>
  <Style Selector="TextBlock.subtitular">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TintaTenue}" />
  </Style>
  <Style Selector="TextBlock.tituloTarjeta">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
  </Style>
  <Style Selector="TextBlock.descripcionTarjeta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TintaTenue}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.etiqueta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TintaTenue}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.chipTexto">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.aviso">
    <Setter Property="Foreground" Value="{StaticResource Rosa}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
  </Style>
</Styles>
