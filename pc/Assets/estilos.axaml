<Styles xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia">
  <Style Selector="Border.fondo">
    <Setter Property="Background" Value="{DynamicResource Fondo}" />
  </Style>

  <Style Selector="Border.marco">
    <Setter Property="Background" Value="{DynamicResource Marco}" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.lienzo">
    <Setter Property="Background" Value="{DynamicResource Lienzo}" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.marca">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="{DynamicResource Blanco}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="Border.estadoConexion">
    <Setter Property="Background" Value="{DynamicResource RosaFondo}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Button">
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.pildoraPrincipal">
    <Setter Property="Background" Value="{DynamicResource BotonPrincipal}" />
    <Setter Property="Foreground" Value="{DynamicResource BotonPrincipalTexto}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BotonPrincipalHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Blanco}" />
  </Style>
  <Style Selector="Button.pildoraPrincipal Path">
    <Setter Property="Fill" Value="{DynamicResource Blanco}" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:disabled">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
    <Setter Property="BorderBrush" Value="#D8D8DE" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
  </Style>
  <Style Selector="Button.pildoraPrincipal:disabled Path">
    <Setter Property="Fill" Value="{DynamicResource TintaTenue}" />
  </Style>

  <Style Selector="Button.pildora">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="15,9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.pildora TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="Button.pildora:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
  </Style>
  <Style Selector="Button.pildora:disabled">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
    <Setter Property="BorderBrush" Value="#D9D9DF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.pildora:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
  </Style>
  <Style Selector="Button.pildora:disabled Path">
    <Setter Property="Stroke" Value="{DynamicResource TintaTenue}" />
  </Style>

  <Style Selector="Button.contorno">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.contorno:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
  </Style>

  <Style Selector="Button.cuadrado">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.insignia">
    <Setter Property="Background" Value="{DynamicResource Insignia}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.insignia TextBlock">
    <Setter Property="Foreground" Value="#2B2F6B" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.barraFlotante">
    <Setter Property="Background" Value="{DynamicResource Blanco}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="6,10" />
    <Setter Property="Width" Value="58" />
  </Style>

  <Style Selector="Button.icono">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icono Path">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource TintaSuave}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Button.icono:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
  </Style>
  <Style Selector="Button.icono:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="Button.icono:disabled">
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <Style Selector="Border.tarjeta">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.baldosa">
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Blanco}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,6" />
  </Style>

  <Style Selector="ToggleButton.panelFicha">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Indigo}" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:checked:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:checked">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Indigo}" />
  </Style>
  <Style Selector="ToggleButton.panelFicha:checked svg|Svg.chevronFicha">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <Style Selector="Border.avisoPeligro">
    <Setter Property="Background" Value="{DynamicResource RosaFondo}" />
    <Setter Property="BorderBrush" Value="#F5D1E2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="TextBlock.titular">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="LetterSpacing" Value="-1" />
  </Style>
  <Style Selector="TextBlock.subtitular">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
  </Style>
  <Style Selector="TextBlock.tituloTarjeta">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="TextBlock.descripcionTarjeta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.etiqueta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.chipTexto">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.aviso">
    <Setter Property="Foreground" Value="{DynamicResource Rosa}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="{DynamicResource Blanco}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource Blanco}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Expander.panelDesplegable">
    <Setter Property="Margin" Value="0,2,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.panelDesplegable /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Tarjeta}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.panelDesplegable /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Indigo}" />
  </Style>
  <Style Selector="Expander.panelDesplegable:expanded /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Indigo}" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>

  <!-- Desplegables anidados: mismo lenguaje visual, más compactos -->
  <Style Selector="Expander.panelDesplegable.compacto">
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>
  <Style Selector="Expander.panelDesplegable.compacto /template/ ToggleButton">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="13,9" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Popups de FluentTheme (dropdowns, tooltips) con los colores del tema -->
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource TarjetaHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="BorderBrush" Value="{DynamicResource Indigo}" />
  </Style>
  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
</Styles>
