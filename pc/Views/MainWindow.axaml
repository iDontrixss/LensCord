<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Lenscord.Controls"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="Lenscord.Views.MainWindow"
        Title="Lenscord" Width="1320" Height="900"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fondo}"
        FontFamily="Inter">

  <Border Classes="fondo">
    <Border Classes="marco">
      <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Margin="26,18,26,8" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Classes="marca">
              <Image Source="{Binding IconoMarca}" Width="28" Height="28" Stretch="Uniform" />
            </Border>
            <TextBlock Text="Lenscord" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Tinta}"
                       VerticalAlignment="Center" />
            <svg:Svg Path="/Assets/Icons/chevron-right.svg" Width="12" Height="12"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding TituloSeccion}" FontSize="14" Foreground="{DynamicResource TintaSuave}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="insignia" IsVisible="{Binding FueraDeLinea}">
              <TextBlock Text="SEÑAL SIMULADA" />
            </Border>

            <Border Classes="estadoConexion" IsVisible="{Binding HayTransporte}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Rosa}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TransporteTexto}" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource RosaTexto}" MaxWidth="210" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Button Classes="contorno" Click="OnCambiarModo" Padding="14,8"
                    AutomationProperties.Name="Cambiar entre USB y Wi-Fi">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <svg:Svg Path="{Binding IconoModoSvg}" Width="16" Height="16" />
                <TextBlock Text="{Binding TextoModo}" />
              </StackPanel>
            </Button>

            <Button Classes="pildoraPrincipal" Click="OnIniciar"
                    IsEnabled="{Binding PuedeIniciar}" IsVisible="{Binding MostrarIniciar}"
                    AutomationProperties.Name="Iniciar cámara">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <svg:Svg Path="/Assets/Icons/play.svg" Width="14" Height="14" />
                <TextBlock Text="Iniciar cámara" />
              </StackPanel>
            </Button>

            <Button Classes="pildoraPrincipal" Click="OnDetener" IsVisible="{Binding MostrarDetener}"
                    AutomationProperties.Name="Detener cámara">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <svg:Svg Path="/Assets/Icons/stop.svg" Width="12" Height="12" />
                <TextBlock Text="Detener" />
              </StackPanel>
            </Button>
            <Button Classes="icono" Click="OnConfiguracion" ToolTip.Tip="Configuración"
                    AutomationProperties.Name="Abrir configuración">
              <svg:Svg Path="/Assets/Icons/settings.svg" Width="18" Height="18" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="22,0,22,0" IsVisible="{Binding MostrarPanelCamara}">
          <Border Classes="barraFlotante" VerticalAlignment="Center" Margin="0,8,0,8">
            <StackPanel Spacing="4">
              <Button Classes="icono" Click="OnZoomMas" ToolTip.Tip="Acercar"
                      AutomationProperties.Name="Acercar zoom">
                <svg:Svg Path="/Assets/Icons/zoom-in.svg" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnZoomMenos" ToolTip.Tip="Alejar"
                      AutomationProperties.Name="Alejar zoom">
                <svg:Svg Path="/Assets/Icons/zoom-out.svg" Width="22" Height="22" />
              </Button>
              <Rectangle Height="1" Fill="#EAEAEC" Margin="8,5" />
              <Button Classes="icono" Click="OnFlash" ToolTip.Tip="{Binding FlashTooltip}"
                      IsEnabled="{Binding TorchPosible}" AutomationProperties.Name="{Binding FlashTooltip}">
                <svg:Svg Path="{Binding FlashIconSvg}" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnEspejo" ToolTip.Tip="Espejo horizontal"
                      AutomationProperties.Name="Espejo horizontal">
                <svg:Svg Path="/Assets/Icons/mirror.svg" Width="22" Height="22" />
              </Button>
              <Rectangle Height="1" Fill="#EAEAEC" Margin="8,5" />
              <Button Classes="icono" Click="OnPausa" ToolTip.Tip="Pausar o reanudar"
                      AutomationProperties.Name="Pausar o reanudar">
                <svg:Svg Path="/Assets/Icons/pause.svg" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnCamara" ToolTip.Tip="Cambiar de cámara"
                      AutomationProperties.Name="Cambiar de cámara">
                <svg:Svg Path="/Assets/Icons/camera-switch.svg" Width="22" Height="22" />
              </Button>
              <Rectangle Height="1" Fill="#EAEAEC" Margin="8,5" />
              <Button Classes="icono" Click="OnRotar" ToolTip.Tip="Rotar 90 grados"
                      AutomationProperties.Name="Rotar 90 grados">
                <svg:Svg Path="/Assets/Icons/rotate.svg" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnRecorte" ToolTip.Tip="Cambiar recorte"
                      AutomationProperties.Name="Cambiar recorte">
                <svg:Svg Path="/Assets/Icons/crop.svg" Width="22" Height="22" />
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="lienzo">
            <Panel>
              <controles:ParticleField x:Name="Particulas" />

              <ScrollViewer x:Name="LienzoScroll" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Center" Margin="44,6,44,24" Spacing="12">
                  <StackPanel Spacing="7" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Classes="titular" HorizontalAlignment="Center" Text="{Binding Titular}" />
                    <TextBlock Classes="subtitular" HorizontalAlignment="Center" MaxWidth="590"
                               TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Subtitular}" />
                  </StackPanel>

                  <Border Classes="avisoPeligro" IsVisible="{Binding EsPeligro}"
                          HorizontalAlignment="Center" MaxWidth="680">
                    <TextBlock Text="{Binding EstadoAccion}" Foreground="{DynamicResource RosaTexto}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" />
                  </Border>

                  <Viewbox Stretch="Uniform" MaxWidth="720" HorizontalAlignment="Center">
                    <Border Width="1280" Height="720" CornerRadius="40" ClipToBounds="True">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#12141C" />
                          <GradientStop Offset="0.55" Color="#191C27" />
                          <GradientStop Offset="1" Color="#0E1016" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Grid>
                        <Ellipse Width="150" Height="150" Stroke="#2A2E42" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="300" Height="300" Stroke="#202434" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path Data="M 0 16 H 32 M 16 0 V 32" Stroke="#34394E" StrokeThickness="1"
                              Width="32" Height="32" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="VistaPrevia" Source="{Binding Lienzo}" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </Viewbox>

                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Classes="pildora" Click="OnPausa" IsEnabled="{Binding Transmitiendo}"
                            AutomationProperties.Name="Pausar o reanudar">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <svg:Svg Path="/Assets/Icons/pause.svg" Width="15" Height="15" />
                        <TextBlock Text="Pausar" />
                      </StackPanel>
                    </Button>
                    <Button Classes="pildora" Click="OnCamara" IsEnabled="{Binding Transmitiendo}"
                            AutomationProperties.Name="Cambiar de cámara">
                      <TextBlock Text="Cambiar cámara" />
                    </Button>
                    <Button Classes="pildora" Click="OnRecorte" IsEnabled="{Binding Transmitiendo}"
                            AutomationProperties.Name="Cambiar recorte">
                      <TextBlock Text="Recorte" />
                    </Button>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Border Classes="tarjeta" Grid.Column="0">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#E8E8EA">
                          <svg:Svg Path="/Assets/Icons/wifi.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="Conexión" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding TransporteTexto}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="1">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#E3E5FA">
                          <svg:Svg Path="/Assets/Icons/camera.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="Lente" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding LenteTexto}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="2">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#DDF3E8">
                          <svg:Svg Path="/Assets/Icons/image.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="Imagen" />
                        <TextBlock Classes="descripcionTarjeta"
                                   Text="Espejo, rotación y recorte se aplican a la imagen." />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="3">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#F5E7F0">
                          <svg:Svg Path="/Assets/Icons/camera.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="Captura" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="4">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#E8E8EA">
                          <svg:Svg Path="/Assets/Icons/output.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="Salida" />
                        <TextBlock Classes="descripcionTarjeta"
                                   Text="Cámara virtual Lenscord para Discord, OBS y apps de Windows." />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <ToggleButton x:Name="FichaCaptura" Classes="panelFicha" Click="OnPanelFicha"
                                  AutomationProperties.Name="Abrir ajustes de captura">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="baldosa" Background="{DynamicResource PastelLavanda}">
                          <svg:Svg Path="/Assets/Icons/camera.svg" Width="19" Height="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="tituloTarjeta" Text="Ajustes de captura" />
                          <TextBlock Classes="descripcionTarjeta" Text="Cámara, resolución y cadencia." />
                        </StackPanel>
                        <svg:Svg Grid.Column="2" Classes="chevronFicha" Path="/Assets/Icons/chevron-right.svg"
                                 Width="15" Height="15" VerticalAlignment="Center" />
                      </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="FichaWifi" Classes="panelFicha" Click="OnPanelFicha"
                                  IsVisible="{Binding MostrarPanelWifi}"
                                  AutomationProperties.Name="Abrir conexión Wi-Fi">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="baldosa" Background="{DynamicResource RosaFondo}">
                          <svg:Svg Path="/Assets/Icons/wifi.svg" Width="19" Height="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="tituloTarjeta" Text="Conexión Wi-Fi" />
                          <TextBlock Classes="descripcionTarjeta" Text="Buscar, emparejar y conectar el teléfono." />
                        </StackPanel>
                        <svg:Svg Grid.Column="2" Classes="chevronFicha" Path="/Assets/Icons/chevron-right.svg"
                                 Width="15" Height="15" VerticalAlignment="Center" />
                      </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="FichaRegistro" Classes="panelFicha" Click="OnPanelFicha"
                                  AutomationProperties.Name="Abrir registro">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="baldosa" Background="{DynamicResource PastelGris}">
                          <svg:Svg Path="/Assets/Icons/output.svg" Width="19" Height="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="tituloTarjeta" Text="Registro" />
                          <TextBlock Classes="descripcionTarjeta" Text="Diagnóstico de la sesión actual." />
                        </StackPanel>
                        <svg:Svg Grid.Column="2" Classes="chevronFicha" Path="/Assets/Icons/chevron-right.svg"
                                 Width="15" Height="15" VerticalAlignment="Center" />
                      </Grid>
                    </ToggleButton>
                  </StackPanel>

                  <Border x:Name="PanelCapturaContenido" Classes="tarjeta" IsVisible="False">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Classes="etiqueta" Text="Cámara" />
                          <ComboBox ItemsSource="{Binding Camaras}" SelectedItem="{Binding Camara}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="etiqueta" Text="Resolución y cadencia" />
                          <ComboBox ItemsSource="{Binding Resoluciones}"
                                    SelectedItem="{Binding ResolucionSeleccionada}"
                                    SelectionChanged="OnResolucion"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Texto}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="descripcionTarjeta"
                                 Text="{Binding TipoZoom, StringFormat='Tipo de zoom: {0}'}" />
                    </StackPanel>
                  </Border>

                  <Border x:Name="PanelWifiContenido" Classes="tarjeta" IsVisible="False">
                    <StackPanel Spacing="12">
                      <Button Classes="pildora" Click="OnDetectarWifi" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <svg:Svg Path="/Assets/Icons/wifi.svg" Width="17" Height="17" />
                          <TextBlock Text="Buscar dispositivos" />
                        </StackPanel>
                      </Button>

                      <ItemsControl ItemsSource="{Binding WifiDispositivos}"
                                    IsVisible="{Binding HayDispositivosWifi}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="tarjeta" Padding="12" Margin="0,0,0,8" Background="{DynamicResource TarjetaHover}">
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource Tinta}" />
                                  <TextBlock Text="{Binding Resumen}" Classes="descripcionTarjeta" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="pildora" Click="OnEmparejarDispositivoWifi"
                                        IsVisible="{Binding TieneEmparejamiento}">
                                  <TextBlock Text="Emparejar" />
                                </Button>
                                <Button Grid.Column="2" Classes="pildoraPrincipal" Click="OnConectarDispositivoWifi"
                                        IsEnabled="{Binding TieneConexion}">
                                  <TextBlock Text="Conectar" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <StackPanel Spacing="4" MaxWidth="260" HorizontalAlignment="Left">
                        <TextBlock Classes="etiqueta" Text="Código de emparejamiento del teléfono" />
                        <TextBox Text="{Binding WifiCodigo}" Watermark="6 dígitos" MaxLength="6" />
                      </StackPanel>

                      <Expander Classes="panelDesplegable compacto" Header="Conectar manualmente con IP"
                                IsExpanded="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                          <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                              <TextBlock Classes="etiqueta" Text="IP del celular" />
                              <TextBox Text="{Binding WifiIp}" Watermark="192.168.1.50" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Classes="etiqueta" Text="Puerto de conexión" />
                              <TextBox Text="{Binding WifiPuerto}" Watermark="5555" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                              <TextBlock Classes="etiqueta" Text="Puerto de emparejamiento" />
                              <TextBox Text="{Binding WifiPuertoEmparejamiento}" Watermark="37123" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="pildora" Click="OnEmparejar">
                              <TextBlock Text="Emparejar por IP" />
                            </Button>
                            <Button Classes="pildoraPrincipal" Click="OnConectarWifi">
                              <TextBlock Text="Conectar por IP" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Expander>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="pildora" Click="OnActivarWifi">
                          <TextBlock Text="Activar Wi-Fi por USB" />
                        </Button>
                        <Button Classes="pildora" Click="OnVolverUsb">
                          <TextBlock Text="Volver a USB" />
                        </Button>
                      </StackPanel>
                      <TextBlock Classes="descripcionTarjeta" Text="{Binding WifiEstado}" />
                    </StackPanel>
                  </Border>

                  <Border x:Name="PanelRegistroContenido" Background="#151517" CornerRadius="18" Padding="14"
                          IsVisible="False">
                    <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Registro}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11" Foreground="#CFCFD6" TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="22,0,22,0" IsVisible="{Binding MostrarPanelConfiguracion}">
          <Border Classes="lienzo">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="1080" HorizontalAlignment="Center" Margin="40,28,40,32" Spacing="18">
                <StackPanel Spacing="6">
                  <TextBlock Classes="titular" Text="Configuración" FontSize="32" />
                </StackPanel>
                <Grid ColumnDefinitions="210,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="12">
                    <Border Classes="tarjeta" Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="etiqueta" Text="PREFERENCIAS" Margin="8,2,0,4" />
                        <Border Background="{DynamicResource TarjetaHover}" CornerRadius="12" Padding="11,10">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <svg:Svg Path="/Assets/Icons/image.svg" Width="17" Height="17" />
                            <TextBlock Text="Apariencia" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" />
                          </StackPanel>
                        </Border>
                        <Border Classes="chip" Padding="11,10">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <svg:Svg Path="{Binding IconoModoSvg}" Width="17" Height="17" />
                            <TextBlock Text="Cámara y conexión" Foreground="{DynamicResource TintaSuave}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="14">
                      <StackPanel Spacing="7">
                        <TextBlock Classes="etiqueta" Text="SESIÓN ACTUAL" />
                        <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" TextWrapping="Wrap" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding TransporteTexto}" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding LenteTexto}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="14">
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="5">
                          <TextBlock Classes="tituloTarjeta" Text="Apariencia" FontSize="20" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Temas}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Width="148" Margin="0,0,10,10" Padding="7" Background="{DynamicResource Marco}"
                                      BorderBrush="{Binding ColorBorde}" BorderThickness="1.5" CornerRadius="15"
                                      Click="OnSeleccionarTema" AutomationProperties.Name="Elegir tema">
                                <StackPanel Spacing="9">
                                  <Border Height="78" Background="{Binding BrochaFondo}" CornerRadius="10" Padding="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                      <Border Background="{Binding BrochaSuperficie}" CornerRadius="6" Width="38" />
                                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="{Binding BrochaSuperficie}" Height="10" CornerRadius="5" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                          <Ellipse Width="8" Height="8" Fill="{Binding BrochaAcento}" />
                                          <Border Background="{Binding BrochaSuperficie}" Width="48" Height="7" CornerRadius="4" />
                                        </StackPanel>
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" />
                                      <TextBlock Text="{Binding Descripcion}" FontSize="10" Foreground="{DynamicResource TintaTenue}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="chip" Padding="6,3" IsVisible="{Binding Seleccionado}">
                                      <TextBlock Text="Activo" FontSize="9" Foreground="{DynamicResource Indigo}" />
                                    </Border>
                                  </Grid>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="tituloTarjeta" Text="Cámara y conexión" FontSize="18" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Modelo}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" />
                            <TextBlock Classes="descripcionTarjeta" Text="{Binding EstadoAccion}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="pildora" Click="OnCambiarModo">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <svg:Svg Path="{Binding IconoModoSvg}" Width="16" Height="16" />
                              <TextBlock Text="Cambiar transporte" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="tituloTarjeta" Text="Salida virtual" FontSize="18" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="26,8,26,18" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="6" Height="6" Fill="#1E9E63" VerticalAlignment="Center" />
                <TextBlock Classes="chipTexto" Text="{Binding EstadoTexto}" />
              </StackPanel>
            </Border>
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{Binding FpsTexto}" />
            </Border>
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{Binding ResolucionTexto}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{Binding Reloj}" />
            </Border>
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="Sesión local" />
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Border>
</Window>

