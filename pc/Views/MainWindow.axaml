<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Lenscord.Controls"
        xmlns:loc="clr-namespace:Lenscord.Core"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="Lenscord.Views.MainWindow"
        Title="Lenscord" Width="1320" Height="900"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fondo}"
        FontFamily="Inter">

  <Border Classes="fondo">
    <Border Classes="marco">
      <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Margin="26,18,26,8" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Classes="marca">
              <Image Source="{Binding IconoMarca}" Width="28" Height="28" Stretch="Uniform" />
            </Border>
            <TextBlock Text="Lenscord" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Tinta}"
                       VerticalAlignment="Center" />
            <svg:Svg Path="/Assets/Icons/chevron-right.svg" Width="12" Height="12"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding TituloSeccion}" FontSize="14" Foreground="{DynamicResource TintaSuave}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="insignia" IsVisible="{Binding FueraDeLinea}">
              <TextBlock Text="{loc:T xaml.senal_simulada}" />
            </Border>

            <Border Classes="estadoConexion" IsVisible="{Binding HayTransporte}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Rosa}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TransporteTexto}" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource RosaTexto}" MaxWidth="210" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Button Classes="contorno" Click="OnCambiarModo" Padding="14,8"
                    AutomationProperties.Name="{loc:T xaml.cambiar_modo}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <svg:Svg Path="{Binding IconoModoSvg}" Width="16" Height="16" />
                <TextBlock Text="{Binding TextoModo}" />
              </StackPanel>
            </Button>

            <Button Classes="pildoraPrincipal" Click="OnIniciar"
                    IsEnabled="{Binding PuedeIniciar}" IsVisible="{Binding MostrarIniciar}"
                    AutomationProperties.Name="{loc:T xaml.iniciar}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <svg:Svg Path="/Assets/Icons/play.svg" Width="14" Height="14" />
                <TextBlock Text="{loc:T xaml.iniciar}" />
              </StackPanel>
            </Button>

            <Button Classes="pildoraPrincipal" Click="OnDetener" IsVisible="{Binding MostrarDetener}"
                    AutomationProperties.Name="{loc:T xaml.detener_camara}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <svg:Svg Path="/Assets/Icons/stop.svg" Width="12" Height="12" />
                <TextBlock Text="{loc:T xaml.detener}" />
              </StackPanel>
            </Button>
            <Button Classes="icono" Click="OnConfiguracion" ToolTip.Tip="{loc:T titulo.configuracion}"
                    AutomationProperties.Name="{loc:T xaml.abrir_configuracion}">
              <svg:Svg Path="/Assets/Icons/settings.svg" Width="18" Height="18" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="22,0,22,0" IsVisible="{Binding MostrarPanelCamara}">
          <Border Classes="barraFlotante" VerticalAlignment="Center" Margin="0,8,0,8">
            <StackPanel Spacing="4">
              <Button Classes="icono" Click="OnZoomMas" ToolTip.Tip="{loc:T xaml.acercar}"
                      AutomationProperties.Name="{loc:T xaml.acercar_zoom}">
                <svg:Svg Path="/Assets/Icons/zoom-in.svg" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnZoomMenos" ToolTip.Tip="{loc:T xaml.alejar}"
                      AutomationProperties.Name="{loc:T xaml.alejar_zoom}">
                <svg:Svg Path="/Assets/Icons/zoom-out.svg" Width="22" Height="22" />
              </Button>
              <Rectangle Height="1" Fill="#EAEAEC" Margin="8,5" />
              <Button Classes="icono" Click="OnFlash" ToolTip.Tip="{Binding FlashTooltip}"
                      IsEnabled="{Binding TorchPosible}" AutomationProperties.Name="{Binding FlashTooltip}">
                <svg:Svg Path="{Binding FlashIconSvg}" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnEspejo" ToolTip.Tip="{loc:T xaml.espejo}"
                      AutomationProperties.Name="{loc:T xaml.espejo}">
                <svg:Svg Path="/Assets/Icons/mirror.svg" Width="22" Height="22" />
              </Button>
              <Rectangle Height="1" Fill="#EAEAEC" Margin="8,5" />
              <Button Classes="icono" Click="OnPausa" ToolTip.Tip="{loc:T xaml.pausar_reanudar}"
                      AutomationProperties.Name="{loc:T xaml.pausar_reanudar}">
                <svg:Svg Path="/Assets/Icons/pause.svg" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnCamara" ToolTip.Tip="{loc:T xaml.cambiar_camara_tip}"
                      AutomationProperties.Name="{loc:T xaml.cambiar_camara_tip}">
                <svg:Svg Path="/Assets/Icons/camera-switch.svg" Width="22" Height="22" />
              </Button>
              <Rectangle Height="1" Fill="#EAEAEC" Margin="8,5" />
              <Button Classes="icono" Click="OnRotar" ToolTip.Tip="{loc:T xaml.rotar}"
                      AutomationProperties.Name="{loc:T xaml.rotar}">
                <svg:Svg Path="/Assets/Icons/rotate.svg" Width="22" Height="22" />
              </Button>
              <Button Classes="icono" Click="OnRecorte" ToolTip.Tip="{loc:T xaml.cambiar_recorte}"
                      AutomationProperties.Name="{loc:T xaml.cambiar_recorte}">
                <svg:Svg Path="/Assets/Icons/crop.svg" Width="22" Height="22" />
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="lienzo">
            <Panel>
              <controles:ParticleField x:Name="Particulas" />

              <ScrollViewer x:Name="LienzoScroll" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="ContenidoLienzo" MaxWidth="1080" Margin="44,6,44,24" Spacing="12">
                  <StackPanel Spacing="7" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Classes="titular" HorizontalAlignment="Center" Text="{Binding Titular}" />
                    <TextBlock Classes="subtitular" HorizontalAlignment="Center" MaxWidth="590"
                               TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Subtitular}" />
                  </StackPanel>

                  <Border Classes="avisoPeligro" IsVisible="{Binding EsPeligro}"
                          HorizontalAlignment="Center" MaxWidth="680">
                    <TextBlock Text="{Binding EstadoAccion}" Foreground="{DynamicResource RosaTexto}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" />
                  </Border>

                  <Viewbox Stretch="Uniform" MaxWidth="720" HorizontalAlignment="Center">
                    <Border Width="1280" Height="720" CornerRadius="40" ClipToBounds="True">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#12141C" />
                          <GradientStop Offset="0.55" Color="#191C27" />
                          <GradientStop Offset="1" Color="#0E1016" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Grid>
                        <Ellipse Width="150" Height="150" Stroke="#2A2E42" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="300" Height="300" Stroke="#202434" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path Data="M 0 16 H 32 M 16 0 V 32" Stroke="#34394E" StrokeThickness="1"
                              Width="32" Height="32" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="VistaPrevia" Source="{Binding Lienzo}" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </Viewbox>

                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Classes="pildora" Click="OnPausa" IsEnabled="{Binding Transmitiendo}"
                            AutomationProperties.Name="{loc:T xaml.pausar_reanudar}">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <svg:Svg Path="/Assets/Icons/pause.svg" Width="15" Height="15" />
                        <TextBlock Text="{loc:T xaml.pausar}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="pildora" Click="OnCamara" IsEnabled="{Binding Transmitiendo}"
                            AutomationProperties.Name="{loc:T xaml.cambiar_camara_tip}">
                      <TextBlock Text="{loc:T xaml.cambiar_camara}" />
                    </Button>
                    <Button Classes="pildora" Click="OnRecorte" IsEnabled="{Binding Transmitiendo}"
                            AutomationProperties.Name="{loc:T xaml.cambiar_recorte}">
                      <TextBlock Text="{loc:T xaml.recorte}" />
                    </Button>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Border Classes="tarjeta" Grid.Column="0" MinHeight="164">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#E8E8EA">
                          <svg:Svg Path="/Assets/Icons/wifi.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.conexion}" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding TransporteTexto}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="1" MinHeight="164">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#E3E5FA">
                          <svg:Svg Path="/Assets/Icons/camera.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.lente}" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding LenteTexto}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="2" MinHeight="164">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#DDF3E8">
                          <svg:Svg Path="/Assets/Icons/image.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.imagen}" />
                        <TextBlock Classes="descripcionTarjeta"
                                   Text="{loc:T xaml.imagen_desc}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="3" MinHeight="164">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#F5E7F0">
                          <svg:Svg Path="/Assets/Icons/camera.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.captura}" />
                        <TextBlock Classes="descripcionTarjeta"
                                   Text="{loc:T xaml.captura_desc}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="tarjeta" Grid.Column="4" MinHeight="164">
                      <StackPanel Spacing="9">
                        <Border Classes="baldosa" Background="#E8E8EA">
                          <svg:Svg Path="/Assets/Icons/output.svg" Width="21" Height="21" />
                        </Border>
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.salida}" />
                        <TextBlock Classes="descripcionTarjeta"
                                   Text="{loc:T xaml.salida_desc}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <ToggleButton x:Name="FichaCaptura" Classes="panelFicha" Click="OnPanelFicha"
                                  AutomationProperties.Name="{loc:T xaml.abrir_captura}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="baldosa" Background="{DynamicResource PastelLavanda}">
                          <svg:Svg Path="/Assets/Icons/camera.svg" Width="19" Height="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.ajustes_captura}" />
                          <TextBlock Classes="descripcionTarjeta" Text="{loc:T xaml.ajustes_captura_desc}" />
                        </StackPanel>
                        <svg:Svg Grid.Column="2" Classes="chevronFicha" Path="/Assets/Icons/chevron-right.svg"
                                 Width="15" Height="15" VerticalAlignment="Center" />
                      </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="FichaWifi" Classes="panelFicha" Click="OnPanelFicha"
                                  IsVisible="{Binding MostrarPanelWifi}"
                                  AutomationProperties.Name="{loc:T xaml.abrir_wifi}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="baldosa" Background="{DynamicResource RosaFondo}">
                          <svg:Svg Path="/Assets/Icons/wifi.svg" Width="19" Height="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.conexion_wifi}" />
                          <TextBlock Classes="descripcionTarjeta" Text="{loc:T xaml.conexion_wifi_desc}" />
                        </StackPanel>
                        <svg:Svg Grid.Column="2" Classes="chevronFicha" Path="/Assets/Icons/chevron-right.svg"
                                 Width="15" Height="15" VerticalAlignment="Center" />
                      </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="FichaRegistro" Classes="panelFicha" Click="OnPanelFicha"
                                  AutomationProperties.Name="{loc:T xaml.abrir_registro}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="baldosa" Background="{DynamicResource PastelGris}">
                          <svg:Svg Path="/Assets/Icons/output.svg" Width="19" Height="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.registro}" />
                          <TextBlock Classes="descripcionTarjeta" Text="{loc:T xaml.registro_desc}" />
                        </StackPanel>
                        <svg:Svg Grid.Column="2" Classes="chevronFicha" Path="/Assets/Icons/chevron-right.svg"
                                 Width="15" Height="15" VerticalAlignment="Center" />
                      </Grid>
                    </ToggleButton>
                  </StackPanel>

                  <Border x:Name="PanelCapturaContenido" Classes="tarjeta" IsVisible="False">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Classes="etiqueta" Text="{loc:T xaml.camara}" />
                          <ComboBox ItemsSource="{Binding Camaras}" SelectedItem="{Binding Camara}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Nombre}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="etiqueta" Text="{loc:T xaml.resolucion}" />
                          <ComboBox ItemsSource="{Binding Resoluciones}"
                                    SelectedItem="{Binding ResolucionSeleccionada}"
                                    SelectionChanged="OnResolucion"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Texto}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="descripcionTarjeta"
                                 Text="{Binding TipoZoomTexto}" />
                    </StackPanel>
                  </Border>

                  <Border x:Name="PanelWifiContenido" Classes="tarjeta" IsVisible="False">
                    <StackPanel Spacing="12">
                      <Button Classes="pildora" Click="OnDetectarWifi" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <svg:Svg Path="/Assets/Icons/wifi.svg" Width="17" Height="17" />
                          <TextBlock Text="{loc:T xaml.buscar_dispositivos}" />
                        </StackPanel>
                      </Button>

                      <ItemsControl ItemsSource="{Binding WifiDispositivos}"
                                    IsVisible="{Binding HayDispositivosWifi}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="tarjeta" Padding="12" Margin="0,0,0,8" Background="{DynamicResource TarjetaHover}">
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource Tinta}" />
                                  <TextBlock Text="{Binding Resumen}" Classes="descripcionTarjeta" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="pildora" Click="OnEmparejarDispositivoWifi"
                                        IsVisible="{Binding TieneEmparejamiento}">
                                  <TextBlock Text="{loc:T xaml.emparejar}" />
                                </Button>
                                <Button Grid.Column="2" Classes="pildoraPrincipal" Click="OnConectarDispositivoWifi"
                                        IsEnabled="{Binding TieneConexion}">
                                  <TextBlock Text="{loc:T xaml.conectar}" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <StackPanel Spacing="4" MaxWidth="260" HorizontalAlignment="Left">
                        <TextBlock Classes="etiqueta" Text="{loc:T xaml.codigo}" />
                        <TextBox Text="{Binding WifiCodigo}" Watermark="{loc:T xaml.seis_digitos}" MaxLength="6" />
                      </StackPanel>

                      <Expander Classes="panelDesplegable compacto" Header="{loc:T xaml.conectar_manual}"
                                IsExpanded="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                          <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                              <TextBlock Classes="etiqueta" Text="{loc:T xaml.ip_celular}" />
                              <TextBox Text="{Binding WifiIp}" Watermark="192.168.1.50" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Classes="etiqueta" Text="{loc:T xaml.puerto_conexion}" />
                              <TextBox Text="{Binding WifiPuerto}" Watermark="5555" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                              <TextBlock Classes="etiqueta" Text="{loc:T xaml.puerto_emparejamiento}" />
                              <TextBox Text="{Binding WifiPuertoEmparejamiento}" Watermark="37123" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="pildora" Click="OnEmparejar">
                              <TextBlock Text="{loc:T xaml.emparejar_ip}" />
                            </Button>
                            <Button Classes="pildoraPrincipal" Click="OnConectarWifi">
                              <TextBlock Text="{loc:T xaml.conectar_ip}" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Expander>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="pildora" Click="OnActivarWifi">
                          <TextBlock Text="{loc:T xaml.activar_wifi}" />
                        </Button>
                        <Button Classes="pildora" Click="OnVolverUsb">
                          <TextBlock Text="{loc:T xaml.volver_usb}" />
                        </Button>
                      </StackPanel>
                      <TextBlock Classes="descripcionTarjeta" Text="{Binding WifiEstado}" />
                    </StackPanel>
                  </Border>

                  <Border x:Name="PanelRegistroContenido" Background="#151517" CornerRadius="18" Padding="14"
                          IsVisible="False">
                    <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Registro}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11" Foreground="#CFCFD6" TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="22,0,22,0" IsVisible="{Binding MostrarPanelConfiguracion}">
          <Border Classes="lienzo">
            <ScrollViewer x:Name="ScrollConfiguracion" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ContenidoConfiguracion" MaxWidth="1080" Margin="40,28,40,32" Spacing="18">
                <StackPanel Spacing="6">
                  <TextBlock Classes="titular" Text="{loc:T titulo.configuracion}" FontSize="32" />
                </StackPanel>
                <Grid ColumnDefinitions="210,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="12">
                    <Border Classes="tarjeta" Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="etiqueta" Text="{loc:T xaml.preferencias}" Margin="8,2,0,4" />
                        <Border Background="{DynamicResource TarjetaHover}" CornerRadius="12" Padding="11,10">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <svg:Svg Path="/Assets/Icons/image.svg" Width="17" Height="17" />
                            <TextBlock Text="{loc:T xaml.apariencia}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" />
                          </StackPanel>
                        </Border>
                        <Border Classes="chip" Padding="11,10">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <svg:Svg Path="{Binding IconoModoSvg}" Width="17" Height="17" />
                            <TextBlock Text="{loc:T xaml.camara_conexion}" Foreground="{DynamicResource TintaSuave}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="14">
                      <StackPanel Spacing="7">
                        <TextBlock Classes="etiqueta" Text="{loc:T xaml.sesion_actual}" />
                        <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" TextWrapping="Wrap" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding TransporteTexto}" />
                        <TextBlock Classes="descripcionTarjeta" Text="{Binding LenteTexto}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="14">
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="14">
                        <StackPanel Spacing="5">
                          <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.apariencia}" FontSize="20" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Temas}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Width="148" Margin="0,0,10,10" Padding="7" Background="{DynamicResource Marco}"
                                      BorderBrush="{Binding ColorBorde}" BorderThickness="1.5" CornerRadius="15"
                                      Click="OnSeleccionarTema" AutomationProperties.Name="{loc:T xaml.elegir_tema}">
                                <StackPanel Spacing="9">
                                  <Border Height="78" Background="{Binding BrochaFondo}" CornerRadius="10" Padding="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                      <Border Background="{Binding BrochaSuperficie}" CornerRadius="6" Width="38" />
                                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="{Binding BrochaSuperficie}" Height="10" CornerRadius="5" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                          <Ellipse Width="8" Height="8" Fill="{Binding BrochaAcento}" />
                                          <Border Background="{Binding BrochaSuperficie}" Width="48" Height="7" CornerRadius="4" />
                                        </StackPanel>
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" />
                                      <TextBlock Text="{Binding Descripcion}" FontSize="10" Foreground="{DynamicResource TintaTenue}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="chip" Padding="6,3" IsVisible="{Binding Seleccionado}">
                                      <TextBlock Text="{loc:T xaml.activo}" FontSize="9" Foreground="{DynamicResource Indigo}" />
                                    </Border>
                                  </Grid>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="12">
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.idioma}" FontSize="18" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button Classes="pildora" Click="OnIdiomaEs">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="Español" />
                              <Border Classes="chip" Padding="6,3" IsVisible="{Binding IdiomaEsEs}">
                                <TextBlock Text="{loc:T xaml.activo}" FontSize="9" Foreground="{DynamicResource Indigo}" />
                              </Border>
                            </StackPanel>
                          </Button>
                          <Button Classes="pildora" Click="OnIdiomaEn">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="English" />
                              <Border Classes="chip" Padding="6,3" IsVisible="{Binding IdiomaEsEn}">
                                <TextBlock Text="{loc:T xaml.activo}" FontSize="9" Foreground="{DynamicResource Indigo}" />
                              </Border>
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.camara_conexion}" FontSize="18" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Modelo}" FontWeight="SemiBold" Foreground="{DynamicResource Tinta}" />
                            <TextBlock Classes="descripcionTarjeta" Text="{Binding EstadoAccion}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="pildora" Click="OnCambiarModo">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <svg:Svg Path="{Binding IconoModoSvg}" Width="16" Height="16" />
                              <TextBlock Text="{loc:T xaml.cambiar_transporte}" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.salida_virtual}" FontSize="18" />
                      </StackPanel>
                    </Border>
                    <Border Classes="tarjeta" Padding="20">
                      <StackPanel Spacing="12">
                        <TextBlock Classes="tituloTarjeta" Text="{loc:T xaml.introduccion}" FontSize="18" />
                        <TextBlock Classes="descripcionTarjeta" Text="{loc:T xaml.introduccion_desc}" />
                        <Button Classes="pildora" Click="OnRepetirIntroduccion" HorizontalAlignment="Left">
                          <TextBlock Text="{loc:T xaml.repetir_introduccion}" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="26,8,26,18" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="chip">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="6" Height="6" Fill="#1E9E63" VerticalAlignment="Center" />
                <TextBlock Classes="chipTexto" Text="{Binding EstadoTexto}" />
              </StackPanel>
            </Border>
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{Binding FpsTexto}" />
            </Border>
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{Binding ResolucionTexto}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{Binding Reloj}" />
            </Border>
            <Border Classes="chip">
              <TextBlock Classes="chipTexto" Text="{loc:T xaml.sesion_local}" />
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Border>
</Window>

